# Runtime mode: development, test, or production.
TRUSTLENS_ENV=development
TRUSTLENS_API_HOST=127.0.0.1
TRUSTLENS_API_PORT=8000
TRUSTLENS_LOG_LEVEL=INFO
TRUSTLENS_DEBUG=true

# MongoDB is optional during local scaffold development. Never commit real
# credentials or signing keys in an .env file.
TRUSTLENS_MONGODB_URI=
TRUSTLENS_MONGODB_DATABASE=trustlens
TRUSTLENS_JWT_SECRET_KEY=
TRUSTLENS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
TRUSTLENS_CORS_ORIGINS=http://localhost:5173
# Optional override; the default resolves to ../models/best_model.pth.
# TRUSTLENS_TAMPERING_MODEL_PATH=
# Optional override; the default resolves to ../models/ai_detector_best.pth.
# TRUSTLENS_AI_DETECTOR_MODEL_PATH=
TRUSTLENS_EASYOCR_DOWNLOAD_ENABLED=false
# Optional override; defaults to backend/model_weights/easyocr.
# TRUSTLENS_EASYOCR_MODEL_STORAGE_PATH=
# Optional override; normalized uploaded-image artifacts are kept server-side.
# TRUSTLENS_UPLOADS_PATH=

# Optional: enables a concise narrative in PDFs from saved analysis facts only.
# Never expose this key to the frontend or commit backend/.env.
XAI_API_KEY=
TRUSTLENS_XAI_MODEL=grok-4.7
