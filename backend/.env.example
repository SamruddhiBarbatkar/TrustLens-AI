# MongoDB is the recommended database for new installations. Start a local
# MongoDB server or use a MongoDB Atlas connection URI. Keep credentials only
# in this untracked .env file.
DATABASE_BACKEND=mongodb
# For Atlas, replace this with the Python driver URI copied from Atlas:
# mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
# URL-encode special characters in the URI username or password.
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=trustlens
# To use the existing SQLite database instead, set DATABASE_BACKEND=sqlite,
# set DATABASE_URL, and run `alembic upgrade head`.
DATABASE_URL=sqlite:///./sql_app.db

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
UPLOAD_CHUNK_BYTES=1048576
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Allows Vite to select another local port such as 5174 when 5173 is busy.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):\d+$

# Replace these values outside local development.
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
BOOTSTRAP_ADMIN_EMAIL=admin@trustlens.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=TrustLens Administrator

# Keep LEGACY until the locked hybrid policy passes final confirmation.
# HYBRID_V1 uses the specialist EfficientNet for AI generation and the
# single-view three-class EfficientNet for tampering. HYBRID_V2 promotes the
# externally calibrated forensic global-plus-patch tampering checkpoint.
DETECTOR_POLICY_MODE=LEGACY
AI_GENERATION_CANDIDATE_PATH=training_outputs/ai_detector_multigen_candidate.pth
EVIDENCE_AUTHENTICITY_CANDIDATE_PATH=training_outputs/evidence_authenticity_three_class_candidate.pth
MULTIVIEW_CANDIDATE_PATH=training_outputs/evidence_authenticity_forensic_multiview_candidate.pth
RESNET_SHADOW_CANDIDATE_PATH=training_outputs/tampering_multisource_hardnegative_candidate.pth
ENABLE_RESNET_SHADOW=true
# Research-only global-plus-patch inference. It is always excluded from the
# Trust Score until a separately calibrated policy is validated and activated.
ENABLE_MULTIVIEW_CANDIDATE=false
